{
  "name": "@oto-yikama/api",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --env-file=.env --watch -r @swc-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "start:prod": "prisma migrate deploy && node dist/main.js",
    "db:seed:prod": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "typescript": "~5.7",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
