// Para tutarları kuruş cinsinden Int (ör. 125,50 TL = 12550).
// KDV oranı baz puan cinsinden Int (ör. %20 = 2000).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
  WORKER
}

enum WorkOrderStatus {
  BEKLIYOR
  YIKANIYOR
  KURULANIYOR
  HAZIR
  TESLIM_EDILDI
  CANCELLED
}

enum PaymentMethod {
  NAKIT
  KART
  HAVALE
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         Role
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  sessions           Session[]
  assignedWorkOrders WorkOrder[]          @relation("AssignedWorker")
  createdWorkOrders  WorkOrder[]          @relation("CreatedBy")
  payments           Payment[]
  statusChanges      WorkOrderStatusLog[]
  cashClosings       CashClosing[]
  soldPackages       CustomerPackage[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  // Çerezdeki ham token değil, SHA-256 özeti saklanır.
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model Customer {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  phone            String?
  // Veresiye: yalnız yöneticinin izin verdiği müşteri bakiyeyle teslim alabilir.
  creditAllowed    Boolean   @default(false) @map("credit_allowed")
  creditLimitKurus Int?      @map("credit_limit_kurus")
  // KVKK: SMS bildirimi yalnız açık rıza ile gönderilir.
  smsConsent       Boolean   @default(false) @map("sms_consent")
  smsConsentAt     DateTime? @map("sms_consent_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  vehicles         Vehicle[]
  workOrders       WorkOrder[]
  customerPackages CustomerPackage[]
  notifications    Notification[]

  @@index([phone])
  @@map("customers")
}

model Vehicle {
  id         String    @id @default(uuid()) @db.Uuid
  // Normalize edilmiş: büyük harf, boşluksuz (CHECK kısıtı migration'da).
  // Benzersizlik silinmemiş kayıtlar arasında (kısmi unique index, migration'da).
  plate      String
  customerId String?   @map("customer_id") @db.Uuid
  brand      String?
  model      String?
  color      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  customer   Customer?   @relation(fields: [customerId], references: [id])
  workOrders WorkOrder[]

  @@index([customerId])
  @@map("vehicles")
}

model Service {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  priceKurus Int       @map("price_kurus")
  vatRateBp  Int       @map("vat_rate_bp")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  items            WorkOrderItem[]
  packages         Package[]
  customerPackages CustomerPackage[]

  @@map("services")
}

model WorkOrder {
  id               String          @id @default(uuid()) @db.Uuid
  vehicleId        String          @map("vehicle_id") @db.Uuid
  customerId       String?         @map("customer_id") @db.Uuid
  status           WorkOrderStatus @default(BEKLIYOR)
  assignedWorkerId String?         @map("assigned_worker_id") @db.Uuid
  createdById      String          @map("created_by_id") @db.Uuid
  note             String?
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deliveredAt      DateTime?       @map("delivered_at") @db.Timestamptz(3)
  cancelledAt      DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(3)

  vehicle        Vehicle              @relation(fields: [vehicleId], references: [id])
  customer       Customer?            @relation(fields: [customerId], references: [id])
  assignedWorker User?                @relation("AssignedWorker", fields: [assignedWorkerId], references: [id])
  createdBy      User                 @relation("CreatedBy", fields: [createdById], references: [id])
  items          WorkOrderItem[]
  payments       Payment[]
  statusLogs     WorkOrderStatusLog[]
  notifications  Notification[]

  @@index([vehicleId])
  @@index([customerId])
  @@index([assignedWorkerId, status])
  @@index([status, createdAt])
  @@map("work_orders")
}

model WorkOrderItem {
  id                String    @id @default(uuid()) @db.Uuid
  workOrderId       String    @map("work_order_id") @db.Uuid
  serviceId         String    @map("service_id") @db.Uuid
  // Eklendiği andaki hizmet bilgileri kopyalanır; sonraki fiyat değişikliklerinden etkilenmez.
  serviceName       String    @map("service_name")
  unitPrice         Int       @map("unit_price")
  vatRateBp         Int       @map("vat_rate_bp")
  quantity          Int       @default(1)
  // Paket kredisiyle karşılanan kalem: unit_price = 0, kredi bu paketten düşülür.
  customerPackageId String?   @map("customer_package_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  workOrder       WorkOrder        @relation(fields: [workOrderId], references: [id])
  service         Service          @relation(fields: [serviceId], references: [id])
  customerPackage CustomerPackage? @relation(fields: [customerPackageId], references: [id], onDelete: Restrict)

  @@index([workOrderId])
  @@index([serviceId])
  @@index([customerPackageId])
  @@map("work_order_items")
}

// Ödemeler hiçbir zaman silinmez (DELETE trigger ile engellenir). Düzeltme gerekirse iade kaydı eklenir.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  // Ödeme ya bir iş emrine ya bir paket satışına aittir (CHECK ile tam olarak biri).
  workOrderId       String?       @map("work_order_id") @db.Uuid
  customerPackageId String?       @map("customer_package_id") @db.Uuid
  // Pozitif: tahsilat. Negatif: iade (yalnız ADMIN, açıklama zorunlu).
  amountKurus       Int           @map("amount_kurus")
  method            PaymentMethod
  note              String?
  // İstemcinin ürettiği anahtar: çift tıklama/yeniden denemede ikinci tahsilatı engeller.
  idempotencyKey    String        @unique @default(dbgenerated("gen_random_uuid()")) @map("idempotency_key") @db.Uuid
  receivedById      String        @map("received_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  workOrder       WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  customerPackage CustomerPackage? @relation(fields: [customerPackageId], references: [id], onDelete: Restrict)
  receivedBy      User             @relation(fields: [receivedById], references: [id])

  @@index([workOrderId])
  @@index([customerPackageId])
  @@index([createdAt])
  @@map("payments")
}

model WorkOrderStatusLog {
  id          String           @id @default(uuid()) @db.Uuid
  workOrderId String           @map("work_order_id") @db.Uuid
  fromStatus  WorkOrderStatus? @map("from_status")
  toStatus    WorkOrderStatus  @map("to_status")
  changedById String           @map("changed_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  changedBy User      @relation(fields: [changedById], references: [id])

  @@index([workOrderId])
  @@index([changedById])
  @@map("work_order_status_logs")
}

// Tek satırlık işletme ayarları (id her zaman 1).
model BusinessSettings {
  id               Int      @id @default(1)
  name             String   @default("Oto Yıkama")
  address          String?
  phone            String?
  taxOffice        String?  @map("tax_office")
  taxNumber        String?  @map("tax_number")
  receiptFooter    String?  @map("receipt_footer")
  smsEnabled       Boolean  @default(false) @map("sms_enabled")
  smsReadyTemplate String   @default("Sayın {musteri}, {plaka} plakalı aracınız hazır. {isletme}") @map("sms_ready_template")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("business_settings")
}

// Gün sonu kasa kapanışı: gün başına bir kayıt, değiştirilemez.
model CashClosing {
  id                String   @id @default(uuid()) @db.Uuid
  businessDate      DateTime @unique @map("business_date") @db.Date
  openingFloatKurus Int      @map("opening_float_kurus")
  cashInKurus       Int      @map("cash_in_kurus")
  expectedKurus     Int      @map("expected_kurus")
  countedKurus      Int      @map("counted_kurus")
  differenceKurus   Int      @map("difference_kurus")
  note              String?
  closedById        String   @map("closed_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  closedBy User @relation(fields: [closedById], references: [id])

  @@index([closedById])
  @@map("cash_closings")
}

// Satılabilir paket tanımı (ör. "10 Dış Yıkama").
model Package {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  serviceId  String    @map("service_id") @db.Uuid
  credits    Int
  priceKurus Int       @map("price_kurus")
  vatRateBp  Int       @map("vat_rate_bp")
  validDays  Int?      @map("valid_days")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  service Service           @relation(fields: [serviceId], references: [id])
  sales   CustomerPackage[]

  @@index([serviceId])
  @@map("packages")
}

// Müşteriye satılmış paket; satış anındaki bilgiler kopyalanır.
model CustomerPackage {
  id               String    @id @default(uuid()) @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  packageId        String    @map("package_id") @db.Uuid
  serviceId        String    @map("service_id") @db.Uuid
  name             String
  totalCredits     Int       @map("total_credits")
  remainingCredits Int       @map("remaining_credits")
  priceKurus       Int       @map("price_kurus")
  vatRateBp        Int       @map("vat_rate_bp")
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(3)
  soldById         String    @map("sold_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer        @relation(fields: [customerId], references: [id])
  package  Package         @relation(fields: [packageId], references: [id])
  service  Service         @relation(fields: [serviceId], references: [id])
  soldBy   User            @relation(fields: [soldById], references: [id])
  items    WorkOrderItem[]
  payments Payment[]

  @@index([customerId])
  @@index([packageId])
  @@index([serviceId])
  @@index([soldById])
  @@map("customer_packages")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// Giden bildirim kuyruğu (outbox): iş emri ile aynı transaction'da yazılır, arka planda gönderilir.
model Notification {
  id            String             @id @default(uuid()) @db.Uuid
  kind          String
  workOrderId   String             @map("work_order_id") @db.Uuid
  customerId    String             @map("customer_id") @db.Uuid
  toPhone       String             @map("to_phone")
  body          String
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0)
  lastError     String?            @map("last_error")
  nextAttemptAt DateTime           @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  sentAt        DateTime?          @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  customer  Customer  @relation(fields: [customerId], references: [id])

  @@unique([workOrderId, kind])
  @@index([customerId])
  @@index([status, nextAttemptAt])
  @@map("notifications")
}
