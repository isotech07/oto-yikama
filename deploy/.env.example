# Bu dosyayı deploy/.env olarak kopyalayıp doldurun. deploy/.env ASLA git'e eklenmez.

# Sunucunun alan adı (DNS A kaydı sunucu IP'sini göstermeli). Deneme için: localhost
DOMAIN=localhost

# Uzun, rastgele bir parola:  openssl rand -base64 32
POSTGRES_PASSWORD=degistir-beni-uzun-rastgele-parola

# İlk yönetici hesabı (yalnız ilk kurulumda seed ile oluşturulur)
SEED_ADMIN_EMAIL=yonetici@ornek.com
SEED_ADMIN_PASSWORD=degistir-beni-en-az-12-karakter

# SMS: "log" (göndermez, yalnız kaydeder) veya "netgsm"
SMS_PROVIDER=log
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# Yedekleme: her gün saat 03'te, 14 gün saklanır (deploy/backups/)
BACKUP_HOUR=03
BACKUP_KEEP_DAYS=14
